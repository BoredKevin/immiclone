[Unit]
Description=Immiclone Storage & Duplication Control Center
After=network.target network-online.target immiclone-rclone.service
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /usr/local/bin/immiclone
Restart=always
RestartSec=5
EnvironmentFile=-/etc/default/immiclone

[Install]
WantedBy=multi-user.target
