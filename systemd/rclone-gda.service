[Unit]
Description=Rclone Mount for remote: (Immich Storage - Legacy Compatibility)
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
User=root
Group=root
Environment=RCLONE_CONFIG=/root/.config/rclone/rclone.conf
Environment=RCLONE_REMOTE=remote:
Environment=MOUNT_POINT=/mnt/gda
Environment=CACHE_DIR=/var/cache/rclone-gda
Environment=CACHE_MAX_SIZE=10G
EnvironmentFile=-/etc/default/immiclone-rclone
ExecStartPre=/bin/mkdir -p ${MOUNT_POINT} ${CACHE_DIR}
ExecStart=/usr/bin/rclone mount ${RCLONE_REMOTE} ${MOUNT_POINT} \
  --allow-other \
  --uid=1000 \
  --gid=1000 \
  --umask 0002 \
  --dir-cache-time 12h \
  --poll-interval 1m \
  --vfs-cache-mode full \
  --vfs-cache-max-size ${CACHE_MAX_SIZE} \
  --vfs-cache-max-age 24h \
  --cache-dir ${CACHE_DIR} \
  --rc \
  --rc-web-gui \
  --rc-web-gui-no-open-browser \
  --rc-addr 0.0.0.0:5572 \
  --rc-no-auth
ExecStop=/bin/fusermount3 -u -z ${MOUNT_POINT}
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
