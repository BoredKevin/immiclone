# Immich Environment Configuration Template
# Copy this file to .env and adjust variables accordingly.

# The location where your uploaded files are stored (mapped to rclone mount)
UPLOAD_LOCATION=/mnt/immiclone/library

# The location where your PostgreSQL database files are stored on SSD
DB_DATA_LOCATION=./postgres

# Timezone identifier (e.g. Asia/Jakarta or UTC)
TZ=Asia/Jakarta

# The Immich release version to use
IMMICH_VERSION=release

# PostgreSQL Credentials
DB_PASSWORD=change_this_to_a_secure_password
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
